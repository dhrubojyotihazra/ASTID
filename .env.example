# ==============================================================================
# ASTID Backend Environment Variables Template (Render / Cloud / Local)
# ==============================================================================

# Server Network Configuration
PORT=8000
HOST=0.0.0.0
# Allowed frontend origins for CORS (e.g. https://astid.vercel.app)
FRONTEND_URL=http://localhost:3000

# Hosted Supabase PostgreSQL Configuration
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
SUPABASE_ANON_KEY=your-supabase-anon-key

# Groq Cloud LPU Compliance Narrative Generator
GROQ_API_KEY=your-groq-api-key

# JWT Signing Secret (generate in production)
ASTID_SECRET_KEY=your-secure-jwt-signing-key
