# ASTID Frontend Environment Variables (Vercel / Local)
# Production FastAPI backend URL (e.g. https://astid-backend.onrender.com/api/v1)
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1

# Optional WebSocket URL (e.g. wss://astid-backend.onrender.com/api/v1/ws/stream)
# If omitted, store.tsx automatically derives it from NEXT_PUBLIC_API_URL
NEXT_PUBLIC_WS_URL=ws://localhost:8000/api/v1/ws/stream

# Hosted Supabase PostgreSQL Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
